  "tokenColors": [
    {
      "name": "Comment",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#5C8656"
      }
    },
    {
      "name": "Keyword, Control Flow, Storage",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.declaration",
        "keyword.other.new",
        "keyword.other.debugger",
        "storage.type",
        "storage.modifier",
        "variable.language.this",
        "variable.language.self",
        "variable.language.super"
      ],
      "settings": {
        "foreground": "#F8906E"
      }
    },
    {
      "name": "Keyword Operator",
      "scope": [
        "keyword.operator",
        "keyword.operator.logical",
        "keyword.operator.arithmetic",
        "keyword.operator.comparison",
        "keyword.operator.assignment",
        "keyword.operator.bitwise",
        "keyword.operator.new"
      ],
      "settings": {
        "foreground": "#7AF8FFCC"
      }
    },
    {
      "name": "String",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "string.regexp",
        "markup.inserted.git_gutter"
      ],
      "settings": {
        "foreground": "#73e165"
      }
    },
    {
      "name": "String Escape",
      "scope": [
        "constant.character.escape",
        "string.regexp constant.character",
        "string.regexp source.ruby.embedded"
      ],
      "settings": {
        "foreground": "#7AF8FF"
      }
    },
    {
      "name": "Template Expression",
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#F8906E"
      }
    },
    {
      "name": "Number, Constant, Boolean",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.language.boolean",
        "constant.language.null",
        "constant.language.undefined",
        "constant.language.nan",
        "support.constant"
      ],
      "settings": {
        "foreground": "#7AF8FF"
      }
    },
    {
      "name": "Constants, Enum Members",
      "scope": [
        "variable.other.constant",
        "variable.other.enummember",
        "constant.other",
        "constant.other.symbol",
        "constant.other.key",
        "constant.other.color",
        "constant.character"
      ],
      "settings": {
        "foreground": "#7AF8FF"
      }
    },
    {
      "name": "Function Definition and Call",
      "scope": [
        "entity.name.function",
        "meta.function-call entity.name.function",
        "variable.function",
        "support.function",
        "keyword.other.special-method"
      ],
      "settings": {
        "foreground": "#77B0FF"
      }
    },
    {
      "name": "Method",
      "scope": [
        "entity.name.function.member",
        "entity.name.method",
        "entity.name.method.js",
        "variable.function.constructor"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#77B0FF"
      }
    },
    {
      "name": "Type, Class, Interface",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.interface",
        "entity.name.enum",
        "entity.name.struct",
        "support.type",
        "support.class",
        "support.type.sys-types",
        "storage.type.class",
        "entity.other.inherited-class",
        "support.other.namespace",
        "meta.use.php"
      ],
      "settings": {
        "foreground": "#C07AC8"
      }
    },
    {
      "name": "Type Parameter",
      "scope": [
        "variable.type.var",
        "entity.name.type.parameter",
        "punctuation.definition.typeparameters"
      ],
      "settings": {
        "foreground": "#C07AC8CC"
      }
    },
    {
      "name": "Variable",
      "scope": [
        "variable",
        "variable.other",
        "variable.other.readwrite",
        "string constant.other.placeholder"
      ],
      "settings": {
        "foreground": "#A2EBA1"
      }
    },
    {
      "name": "Variable Parameter",
      "scope": ["variable.parameter", "meta.function variable.other"],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#D4D256CC"
      }
    },
    {
      "name": "Property, Field, Attribute",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.variable.property",
        "meta.object-literal.key",
        "entity.other.attribute-name",
        "support.type.property-name",
        "source.css support.type.property-name",
        "source.sass support.type.property-name",
        "source.scss support.type.property-name",
        "source.less support.type.property-name",
        "source.stylus support.type.property-name",
        "source.postcss support.type.property-name"
      ],
      "settings": {
        "foreground": "#D4D256"
      }
    },
    {
      "name": "HTML/XML Attribute Name",
      "scope": [
        "text.html entity.other.attribute-name",
        "text.html.basic entity.other.attribute-name",
        "text.xml entity.other.attribute-name"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#D4D256"
      }
    },
    {
      "name": "Tag",
      "scope": [
        "entity.name.tag",
        "meta.tag.sgml",
        "markup.deleted.git_gutter"
      ],
      "settings": {
        "foreground": "#F8906E"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "punctuation.definition.tag",
        "punctuation.definition.tag.html",
        "punctuation.definition.tag.begin.html",
        "punctuation.definition.tag.end.html",
        "punctuation.definition.binding-pattern",
        "meta.brace",
        "meta.delimiter"
      ],
      "settings": {
        "foreground": "#7AF8FFAA"
      }
    },
    {
      "name": "Namespace, Module Import",
      "scope": [
        "entity.name.namespace",
        "entity.name.module",
        "entity.name.module.js",
        "variable.import.parameter.js",
        "variable.other.class.js",
        "support.other.namespace.use.php",
        "support.other.namespace.php"
      ],
      "settings": {
        "foreground": "#A2EBA1"
      }
    },
    {
      "name": "Decorator, Annotation",
      "scope": [
        "meta.decorator",
        "tag.decorator.js entity.name.tag.js",
        "tag.decorator.js punctuation.definition.tag.js",
        "storage.type.annotation",
        "punctuation.decorator"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#C07AC8"
      }
    },
    {
      "name": "Invalid",
      "scope": ["invalid", "invalid.illegal"],
      "settings": {
        "foreground": "#F8906E",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Deprecated",
      "scope": ["invalid.deprecated"],
      "settings": {
        "fontStyle": "strikethrough",
        "foreground": "#DD7975"
      }
    },
    {
      "name": "CSS Class, ID",
      "scope": [
        "entity.other.attribute-name.class",
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css",
        "source.sass keyword.control"
      ],
      "settings": {
        "foreground": "#D4D256"
      }
    },
    {
      "name": "CSS Pseudo-class, Pseudo-element",
      "scope": [
        "entity.other.attribute-name.pseudo-class.css",
        "entity.other.attribute-name.pseudo-element.css"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#C07AC8"
      }
    },
    {
      "name": "CSS Unit, At-rule",
      "scope": [
        "keyword.other.unit",
        "keyword.control.at-rule",
        "variable.scss"
      ],
      "settings": {
        "foreground": "#F8906ECC"
      }
    },
    {
      "name": "JSON Key Level 0",
      "scope": [
        "source.json meta.structure.dictionary.json support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#77B0FF"
      }
    },
    {
      "name": "JSON Key Level 1",
      "scope": [
        "source.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#C07AC8"
      }
    },
    {
      "name": "JSON Key Level 2",
      "scope": [
        "source.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#D4D256"
      }
    },
    {
      "name": "JSON Key Level 3+",
      "scope": [
        "source.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#7AF8FF"
      }
    },
    {
      "name": "Markup Heading",
      "scope": [
        "markup.heading",
        "markup.heading entity.name",
        "markup.heading.markdown punctuation.definition.heading.markdown"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#A2EBA1"
      }
    },
    {
      "name": "Markup Italic",
      "scope": ["markup.italic"],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#D4D256"
      }
    },
    {
      "name": "Markup Bold",
      "scope": ["markup.bold", "markup.bold string"],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#F8906E"
      }
    },
    {
      "name": "Markup Bold-Italic",
      "scope": [
        "markup.bold markup.italic",
        "markup.italic markup.bold",
        "markup.quote markup.bold"
      ],
      "settings": {
        "fontStyle": "bold italic",
        "foreground": "#F8906E"
      }
    },
    {
      "name": "Markup Inserted",
      "scope": ["markup.inserted"],
      "settings": {
        "foreground": "#A2EBA1"
      }
    },
    {
      "name": "Markup Deleted",
      "scope": ["markup.deleted"],
      "settings": {
        "foreground": "#F8906E"
      }
    },
    {
      "name": "Markup Changed",
      "scope": ["markup.changed"],
      "settings": {
        "foreground": "#77B0FF"
      }
    },
    {
      "name": "Markup Underline",
      "scope": ["markup.underline"],
      "settings": {
        "fontStyle": "underline",
        "foreground": "#7AF8FF"
      }
    },
    {
      "name": "Markup Quote",
      "scope": ["markup.quote"],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#4E7249"
      }
    },
    {
      "name": "Markup Raw Inline",
      "scope": [
        "markup.inline.raw",
        "text.html.markdown markup.inline.raw.markdown"
      ],
      "settings": {
        "foreground": "#7AF8FF"
      }
    },
    {
      "name": "Markup Raw Block",
      "scope": ["markup.raw.block"],
      "settings": {
        "foreground": "#7AF8FFCC"
      }
    },
    {
      "name": "Markdown Fenced Block",
      "scope": [
        "markup.raw.block.fenced.markdown",
        "punctuation.definition.fenced.markdown",
        "variable.language.fenced.markdown"
      ],
      "settings": {
        "foreground": "#A2EBA1"
      }
    },
    {
      "name": "Markdown Link",
      "scope": [
        "string.other.link.title.markdown",
        "string.other.link.description.title.markdown"
      ],
      "settings": {
        "foreground": "#77B0FF"
      }
    },
    {
      "name": "Markdown Link URL",
      "scope": [
        "markup.underline.link",
        "constant.other.reference.link.markdown"
      ],
      "settings": {
        "fontStyle": "underline",
        "foreground": "#328EEE"
      }
    },
    {
      "name": "Markdown Separator",
      "scope": ["meta.separator"],
      "settings": {
        "fontStyle": "bold",
        "foreground": "#4E7249"
      }
    },
    {
      "name": "Markdown Punctuation",
      "scope": [
        "punctuation.definition.raw.markdown",
        "punctuation.definition.blockquote.markdown",
        "punctuation.definition.list_item.markdown"
      ],
      "settings": {
        "foreground": "#4E7249"
      }
    },
    {
      "name": "Markup Table",
      "scope": ["markup.table"],
      "settings": {
        "foreground": "#A2EBA1"
      }
    },
    {
      "name": "URL",
      "scope": ["*url*", "*link*", "*uri*"],
      "settings": {
        "fontStyle": "underline"
      }
    },
    {
      "name": "Regular Expressions",
      "scope": ["string.regexp"],
      "settings": {
        "foreground": "#7AF8FF"
      }
    },
    {
      "name": "Regex Quantifier / Anchor",
      "scope": [
        "keyword.operator.quantifier.regexp",
        "keyword.operator.or.regexp",
        "keyword.control.anchor.regexp"
      ],
      "settings": {
        "foreground": "#F8906ECC"
      }
    },
    {
      "name": "Shell Variable",
      "scope": ["variable.other.normal.shell", "source.shell variable.other"],
      "settings": {
        "foreground": "#A2EBA1"
      }
    },
    {
      "name": "Shell Built-in",
      "scope": ["support.function.builtin.shell", "keyword.control.shell"],
      "settings": {
        "foreground": "#F8906E"
      }
    },
    {
      "name": "Python Self",
      "scope": ["variable.language.special.self.python"],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#F8906E"
      }
    },
    {
      "name": "Python Decorator",
      "scope": [
        "meta.function.decorator.python support.type.python",
        "entity.name.function.decorator.python"
      ],
      "settings": {
