        "foreground": "#C07AC8"
      }
    },
    {
      "name": "Rust Lifetime",
      "scope": ["storage.modifier.lifetime.rust", "entity.name.lifetime.rust"],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#D4D256"
      }
    },
    {
      "name": "Rust Macro",
      "scope": ["support.macro.rust", "entity.name.function.macro.rust"],
      "settings": {
        "foreground": "#7AF8FF"
      }
    },
    {
      "name": "Go Type",
      "scope": ["storage.type.go"],
      "settings": {
        "foreground": "#C07AC8"
      }
    },
    {
      "name": "ES7 Bind Operator",
      "scope": [
        "source.js constant.other.object.key.js string.unquoted.label.js"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#F8906E"
      }
    }
  ],

  "semanticTokenColors": {
    "namespace": "#A2EBA1",
    "type": "#C07AC8",
    "class": "#C07AC8",
    "interface": "#C07AC8CC",
    "enum": "#C07AC8",
    "struct": "#C07AC8",
    "typeParameter": "#C07AC8CC",
    "function": "#77B0FF",
    "method": { "foreground": "#77B0FF", "italic": true },
    "decorator": { "foreground": "#C07AC8", "italic": true },
    "macro": "#7AF8FF",
    "variable": "#A2EBA1",
    "variable.constant": "#7AF8FF",
    "variable.defaultLibrary": "#7AF8FF",
    "parameter": { "foreground": "#D1CF32", "italic": true },
    "property": "#DFDD4F",
    "enumMember": "#7AF8FF",
    "event": "#F8906E",
    "keyword": "#F8906E",
    "label": "#D1CF32",
    "comment": { "foreground": "#5C8656", "italic": true },
    "string": "#73e165",
    "number": "#7AF8FF",
    "regexp": "#7AF8FF",
    "operator": "#7AF8FFCC",
    "selfParameter": { "foreground": "#F8906E", "italic": true },
    "builtinType": "#C07AC8CC",
    "lifetime": { "foreground": "#D4D256", "italic": true },
    "unresolvedReference": { "foreground": "#F8906E", "underline": true }
  }
}
